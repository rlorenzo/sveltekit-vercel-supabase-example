{
  "name": "sveltekit-vercel-supabase-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp check && markdownlint-cli2 \"**/*.md\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format": "vp fmt",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "husky": "^9.1.0",
    "jsdom": "^29.0.1",
    "markdownlint-cli2": "^0.22.0",
    "oxfmt-prettier-svelte": "^0.0.1",
    "postcss": "^8.5.8",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plus": "^0.1.15",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.15",
      "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.15"
    }
  }
}
