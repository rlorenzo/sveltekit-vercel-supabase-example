{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", ".svelte-kit", "build", "dist", ".vercel", "playwright-report"],
}
